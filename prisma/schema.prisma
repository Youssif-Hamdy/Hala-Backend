// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application   Application?
  bookings      Booking[]
  consultations Consultation[]

  @@map("users")
}

model Application {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  currentChallenges String  // ابرز النقاط التي يواجهها حاليا (500 كلمة)
  courseGoal     String   // هدفه للالتحاق بالكورس (500 كلمة)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("applications")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("bookings")
}

model Consultation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String
  duration  Int                // 30, 60, or 120 (بالدقائق)
  price     Float              // 20, 30, or 40 (بالدولار)
  notes     String?            // ملاحظات أو تفاصيل الاستشارة
  status    ConsultationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("consultations")
}
